# Copy to `.env.development.local` (gitignored) only when explicitly debugging the local Streamclone stack.
#
# Default dev (`npm run dev` / `npm run dev:hosted`) uses https://api.streampulse.stream when this file is absent.
# Explicit local stack: copy this file OR run `npm run dev:local` (loads this example via --env-file).
#
# Backend selection order (dev only):
#   1. sessionStorage `sp.backendUrlOverride` (cleared via "Use hosted API" on /analytics)
#   2. VITE_BACKEND_URL from `.env.development.local` / Vite env
#   3. default https://api.streampulse.stream
VITE_BACKEND_URL=http://localhost:8090
