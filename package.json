{
  "name": "streamclone-pulse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:package-cohort": "node scripts/check-package-cohort.mjs",
    "check:package-cohort:strict": "node scripts/check-package-cohort.mjs --strict",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "dev": "vite build --watch",
    "predev": "npm run check:package-cohort",
    "build": "vite build",
    "prebuild": "npm run check:package-cohort",
    "check:dist": "node scripts/check-dist-fresh.mjs --repo-root . --dist dist --repository streamclone-pulse-extension --scope src,streampulse-web/src/lib/release-notes.json,public,popup,options,manifest.json,vite.config.ts,scripts/build-provenance.mjs,package.json,package-lock.json",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:package-cohort": "node --test scripts/check-package-cohort.test.mjs",
    "test:e2e": "playwright test --project=extension-mocked",
    "test:e2e:mocked": "playwright test --project=extension-mocked",
    "test:e2e:live": "playwright test --project=live-twitch",
    "capture:extension-goldens": "npx tsx scripts/capture-extension-goldens.mts",
    "icons:cws": "node scripts/gen-cws-icons.mjs",
    "capture:cws:screenshots": "npm run build && npx tsx scripts/capture-cws-live.mts",
    "capture:cws": "npm run icons:cws && npm run capture:cws:screenshots",
    "capture:cws:mocked": "npm run icons:cws && npm run build && playwright test tests/e2e/specs/cws-extension-screenshots.mocked.spec.ts --project=extension-mocked",
    "zip": "node scripts/zip-dist.mjs"
  },
  "dependencies": {
    "@streampulse/pulse-charts": "file:../streampulse-backend/packages/pulse-charts",
    "@streampulse/pulse-core": "file:../streampulse-backend/packages/pulse-core",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "@streampulse/pulse-charts": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "rollup": "^4.43.0",
    "vite": "8.0.16",
    "vitest": "3.2.4"
  }
}
