{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["vite/client", "vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@streampulse/analytics-console": [
        "./node_modules/@streampulse/analytics-console/src/index.tsx"
      ],
      "@streampulse/analytics-console/*": [
        "./node_modules/@streampulse/analytics-console/src/*"
      ],
      "@streampulse/pulse-charts": [
        "./node_modules/@streampulse/pulse-charts/src/index.ts"
      ],
      "@streampulse/pulse-charts/*": ["./node_modules/@streampulse/pulse-charts/src/*"]
    }
  },
  "include": ["tests", "src/vite-env.d.ts"]
}
