{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": [
    "src/routes/analytics/ChannelDatePage.tsx",
    "src/routes/analytics/ChannelSessionKeyRoute.tsx",
    "src/routes/analytics/StreamsHubPage.tsx"
  ]
}
