{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["vite/client", "vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@streampulse/analytics-console": [
        "../../streampulse-backend/packages/analytics-console/src/index.tsx"
