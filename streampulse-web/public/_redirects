# Legacy public routes → Command Center (must be static; client-only Navigate
# never runs when Pages returns 404.html for a missing path).
/analytics/streams /analytics 301
/analytics/streams/ /analytics/ 301
/analytics/hub /analytics 301
/analytics/hub/ /analytics/ 301
/analytics/emotes /analytics 301
/analytics/emotes/ /analytics/ 301
/atlas /analytics 301
/atlas/ /analytics/ 301
/setup /analytics 301
/setup/ /analytics/ 301
/login /analytics 301
/login/ /analytics/ 301

# Channel/session deep links must SPA-fallback — prerender only covers /analytics/.
# Without these, Cloudflare Pages serves 404.html for /analytics/:login/:streamId.
# Newsroom routes are explicit because `newsroom` is a reserved analytics
# segment, not a channel login. Keep both slash forms so direct links and
# Pages' directory normalization reach the SPA shell.
/analytics/newsroom /analytics/ 200
/analytics/newsroom/ /analytics/ 200
/analytics/newsroom/:storyId /analytics/ 200
/analytics/newsroom/:storyId/ /analytics/ 200
# Pages supports a trailing splat for nested paths; the colon forms above are
# retained for readability/backward compatibility with older deploy tooling.
/analytics/* /analytics/ 200
/analytics/:login /analytics/ 200
/analytics/:login/ /analytics/ 200
/analytics/:login/:streamId /analytics/ 200
/analytics/:login/:streamId/ /analytics/ 200
/analytics/:login/s/:streamId /analytics/ 200
/analytics/:login/s/:streamId/ /analytics/ 200
/s/:login /analytics/ 200
/s/:login/:streamId /analytics/ 200
