{
  "name": "streampulse-web",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "node ../scripts/dev-portal.mjs",
    "dev:watch-config": "node ../scripts/dev-portal.mjs --watch-config",
    "dev:vite": "vite",
    "dev:hosted": "node ../scripts/dev-portal.mjs",
    "dev:local": "vite --env-file .env.development.localhost",
    "build:packages": "npm run ensure:packages --prefix ..",
    "build": "npm run build:packages && tsc --noEmit -p tsconfig.json && node scripts/check-analytics-tailwind.mjs && node scripts/check-analytics-routes-spa.mjs && node scripts/check-analytics-links.mjs && node scripts/check-analytics-overlap.mjs && vite build && node scripts/prerender.mjs && node scripts/check-public-pages.mjs && node scripts/check-backend-url.mjs",
    "build:ci": "node scripts/check-analytics-tailwind.mjs && node scripts/check-analytics-routes-spa.mjs && node scripts/check-analytics-links.mjs && node scripts/check-analytics-overlap.mjs && vite build && node scripts/prerender.mjs && node scripts/check-public-pages.mjs && node scripts/check-backend-url.mjs",
    "build:vite": "vite build",
    "typecheck": "npm run build:packages && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:mocked": "node scripts/run-portal-e2e-mocked.mjs",
    "test:e2e:analytics-local": "node scripts/run-analytics-local-e2e.mjs",
    "test:e2e:hosted": "playwright test tests/e2e/analytics-visual-capture.spec.ts --workers=1",
    "capture:analytics": "playwright test tests/e2e/analytics-visual-capture.spec.ts --workers=1",
    "preview": "vite preview",
    "check:analytics-routes-spa": "node scripts/check-analytics-routes-spa.mjs",
    "check:analytics-links": "node scripts/check-analytics-links.mjs",
    "check:analytics-tailwind": "node scripts/check-analytics-tailwind.mjs",
    "check:analytics-overlap": "node scripts/check-analytics-overlap.mjs",
    "check:public-pages": "node scripts/check-public-pages.mjs",
    "check:backend-url": "node scripts/check-backend-url.mjs",
    "status:hosted": "node scripts/hosted-status.mjs",
    "pages:deploy:prod": "node scripts/pages-deploy-prod.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-tabs": "^1.1.15",
    "@sentry/react": "^10.65.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@streampulse/analytics-console": "file:../packages/analytics-console",
    "@streampulse/pulse-charts": "file:../packages/pulse-charts",
    "@streampulse/pulse-core": "file:../packages/pulse-core",
    "@tanstack/react-query": "^5.90.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.9.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "3.2.7",
    "wrangler": "^4.110.0"
  }
}
