# Legacy public routes → Command Center (must be static; client-only Navigate
# never runs when Pages returns 404.html for a missing path).
/analytics/streams /analytics 301
/analytics/streams/ /analytics/ 301
/analytics/hub /analytics 301
/analytics/hub/ /analytics/ 301
/analytics/emotes /analytics 301
/analytics/emotes/ /analytics/ 301
/atlas /analytics 301
/atlas/ /analytics/ 301
/setup /analytics 301
/setup/ /analytics/ 301
/login /analytics 301
/login/ /analytics/ 301

# Account pages are private SPA surfaces, not prerendered marketing pages.
/account/sign-in/ /account/sign-in 301
/account/confirm/ /account/confirm 301
/account/link-device/ /account/link-device 301
/account/settings/ /account/settings 301
/account/billing/ /account/billing 301
/account/billing/return/ /account/billing/return 301
/account/sign-in /index.html 200
/account/confirm /index.html 200
/account/link-device /index.html 200
/account/settings /index.html 200
/account/billing /index.html 200
/account/billing/return /index.html 200

# Known documentation aliases resolve at the edge even without JavaScript.
/docs/getting-started /docs#extension 301
/docs/getting-started/ /docs#extension 301
/docs/coverage /docs#coverage 301
/docs/coverage/ /docs#coverage 301
/docs/api /docs#api 301
/docs/api/ /docs#api 301

# Hosted Explorer links must reach the SPA so the client can map broadcastId and
# window onto the canonical Moments session view. A static 301 cannot carry that
# mapping, so this is a rewrite, not a redirect.
/analytics/explore /analytics/index.html 200
/analytics/explore/ /analytics/index.html 200
/analytics/explore/:broadcastId /analytics/index.html 200
/analytics/explore/:broadcastId/ /analytics/index.html 200

# Channel/session deep links must SPA-fallback — prerender only covers /analytics/.
# Without these, Cloudflare Pages serves 404.html for /analytics/:login/:streamId.
/analytics/:login /analytics/index.html 200
/analytics/:login/ /analytics/index.html 200
/analytics/:login/:streamId /analytics/index.html 200
/analytics/:login/:streamId/ /analytics/index.html 200
/analytics/:login/s/:streamId /analytics/index.html 200
/analytics/:login/s/:streamId/ /analytics/index.html 200
/s/:login /analytics/index.html 200
/s/:login/:streamId /analytics/index.html 200
