{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/streampulse-web-typecheck.py",
        "matcher": "streampulse-web/"
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/tasks-md-reminder.py",
        "loop_limit": 1
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/secrets-scan-pre-commit.py",
        "matcher": "git commit --trailer "Co-authored-by: Cursor <cursoragent@cursor.com>""
      },
      {
        "command": "python .cursor/hooks/analytics-overlap-pre-commit.py",
        "matcher": "git commit --trailer "Co-authored-by: Cursor <cursoragent@cursor.com>""
      }
    ]
  }
}