# Copy to `.env.development.localhost` (gitignored) for explicit local-stack portal dev.
# Use with: npm run dev:local
#
# Vite dev server: http://127.0.0.1:5173 → http://localhost:8090 (Streamclone Caddy)
VITE_BACKEND_URL=http://localhost:8090
# Required gate — without this flag localhost env is ignored (portal stays on hosted API).
VITE_ALLOW_LOCAL_BACKEND=1
