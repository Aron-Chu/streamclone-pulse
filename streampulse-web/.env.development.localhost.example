# Copy to `.env.development.localhost` (gitignored) for explicit local-backend portal dev.
# Use with: npm run dev:local
#
# Vite dev server: http://127.0.0.1:5173 → http://localhost:8081 (streampulse-backend compose)
# NOT Streamclone :8090 — that stack is watch/HLS/chat/emotes only after boundary split.
VITE_BACKEND_URL=http://localhost:8081
# Required gate — without this flag localhost env is ignored (portal stays on hosted API).
VITE_ALLOW_LOCAL_BACKEND=1
