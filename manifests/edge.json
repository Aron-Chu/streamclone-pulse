{
  "manifest_version": 3,
  "name": "StreamPulse: Twitch Chat Stats & Top Moments",
  "short_name": "StreamPulse",
  "description": "See what Twitch chat reacted to: a live Pulse chart of chat and emote activity, Top Moments you can jump to, and stream recaps.",
  "version": "0.2.6",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "StreamPulse"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["content/twitch.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/shadow.css"],
      "matches": ["https://*.twitch.tv/*"]
    }
  ],
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://api.streampulse.stream/*",
    "https://*.twitch.tv/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
