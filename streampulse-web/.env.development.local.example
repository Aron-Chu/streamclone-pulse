# Optional persistent override for `npm run dev`. No file is required for hosted default.
#
# When absent, `auth.ts` falls back to https://api.streampulse.stream.
# Vite dev server: http://127.0.0.1:5173
#
# Hosted production (default — IRC + corpus on streampulse-vps):
# VITE_BACKEND_URL=https://api.streampulse.stream
#
# Local Streamclone stack: use `npm run dev:local` with `.env.development.localhost`
# (see `.env.development.localhost.example`), not this file.
