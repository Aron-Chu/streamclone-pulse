{
  "manifest_version": 3,
  "name": "Streamclone Pulse",
  "description": "Live Pulse overlay for Twitch channels powered by Streamclone analytics.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Streamclone Pulse"
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["content/twitch.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8090/*",
    "http://127.0.0.1:8090/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
