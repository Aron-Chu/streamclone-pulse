# Legacy public routes → Command Center (must be static; client-only Navigate
# never runs when Pages returns 404.html for a missing path).
/analytics/streams /analytics 301
/analytics/streams/ /analytics/ 301
/analytics/hub /analytics 301
/analytics/hub/ /analytics/ 301
/analytics/emotes /analytics 301
/analytics/emotes/ /analytics/ 301
/atlas /analytics 301
/atlas/ /analytics/ 301
/setup /analytics 301
/setup/ /analytics/ 301
/login /analytics 301
/login/ /analytics/ 301

# Account pages are private SPA surfaces, not prerendered marketing pages.
/account/sign-in/ /account/sign-in 301
/account/confirm/ /account/confirm 301
/account/restore/ /account/restore 301
/account/link-device/ /account/link-device 301
/account/settings/ /account/settings 301
/account/billing/ /account/billing 301
/account/billing/return/ /account/billing/return 301
/account/twitch/callback/ /account/twitch/callback 301
/account/moments/ /account/moments 301
# Pages canonicalizes /index.html to /. Rewrite to the canonical asset URL so
# the browser retains the requested account path instead of following a 308.
/account/sign-in / 200
/account/confirm / 200
/account/restore / 200
/account/link-device / 200
/account/settings / 200
/account/billing / 200
/account/billing/return / 200
# Sign in with Twitch returns here with the ID token in the URL fragment, which
# never reaches Pages; the SPA strips it before anything else runs.
/account/twitch/callback / 200
/account/moments / 200

# Static Checkout return remains a no-login surface with no payment claims.
/supporter/thanks/ /supporter/thanks 301

# Known documentation aliases resolve at the edge even without JavaScript.
/docs/getting-started /docs#extension 301
/docs/getting-started/ /docs#extension 301
/docs/coverage /docs#coverage 301
/docs/coverage/ /docs#coverage 301
/docs/api /docs#api 301
/docs/api/ /docs#api 301

# Hosted Explorer links must reach the SPA so the client can map broadcastId and
# window onto the canonical Moments session view. A static 301 cannot carry that
# mapping, so this is a rewrite, not a redirect.
# Use the canonical asset URL: Pages redirects /analytics/index.html to
# /analytics/, which would otherwise discard the requested deep-link path.
/analytics/explore /analytics/ 200
/analytics/explore/ /analytics/ 200
/analytics/explore/:broadcastId /analytics/ 200
/analytics/explore/:broadcastId/ /analytics/ 200

# Channel/session deep links must SPA-fallback — prerender only covers /analytics/.
# Without these, Cloudflare Pages serves 404.html for /analytics/:login/:streamId.
/analytics/:login /analytics/ 200
/analytics/:login/ /analytics/ 200
/analytics/:login/:streamId /analytics/ 200
/analytics/:login/:streamId/ /analytics/ 200
/analytics/:login/s/:streamId /analytics/ 200
/analytics/:login/s/:streamId/ /analytics/ 200
/s/:login /analytics/ 200
/s/:login/:streamId /analytics/ 200
