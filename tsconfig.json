{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "types": ["chrome", "vite/client"],
    "baseUrl": "."
  },
  "include": ["src"],
  "exclude": [
    "src/content/liveVodNavigationCache.ts",
    "src/content/vodChannelLogin.ts",
    "src/ui/chartPinExit.ts",
    "src/ui/chartSelectionHitTest.ts",
    "src/ui/LiveMomentInteractionSurface.tsx",
    "src/ui/presentationPathInBand.ts"
  ]
}
