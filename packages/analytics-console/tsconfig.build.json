{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@streampulse/pulse-core": ["../pulse-core/dist/index.d.ts"],
      "@streampulse/pulse-charts": ["../pulse-charts/dist/index.d.ts"],
      "react-router-dom": ["../../streampulse-web/node_modules/react-router-dom"],
      "@tanstack/react-query": ["../../streampulse-web/node_modules/@tanstack/react-query"],
      "zustand": ["../../streampulse-web/node_modules/zustand"],
      "zustand/*": ["../../streampulse-web/node_modules/zustand/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/components/analytics/TierIndicator.tsx",
    "src/utils/syncProgressLabels.ts"
  ]
}
