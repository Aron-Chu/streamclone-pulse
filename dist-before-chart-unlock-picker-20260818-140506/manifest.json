{
  "manifest_version": 3,
  "name": "StreamPulse",
  "description": "Live Pulse overlay for Twitch — viewers, chat, emotes, and games.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "StreamPulse",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "content/twitch.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8081/*",
    "http://127.0.0.1:8081/*",
    "https://api.streampulse.stream/*",
    "https://*.twitch.tv/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "0.2.0 (f0aefce4-dirty; cohort fb1a5b97)"
}