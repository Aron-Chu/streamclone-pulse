{
  "name": "streamclone-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=extension-mocked",
    "test:e2e:mocked": "playwright test --project=extension-mocked",
    "test:e2e:live": "playwright test --project=live-twitch",
    "capture:extension-goldens": "npx tsx scripts/capture-extension-goldens.mts",
    "zip": "node scripts/zip-dist.mjs",
    "validate:package": "node scripts/validate-extension-package.mjs",
    "package:cws": "npm run build && npm run zip && npm run validate:package"
  },
  "dependencies": {
    "@streampulse/pulse-charts": "file:../streampulse-backend/packages/pulse-charts",
    "@streampulse/pulse-core": "file:../streampulse-backend/packages/pulse-core",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "@streampulse/pulse-charts": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.0.2",
    "rollup": "^4.43.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "3.2.7"
  }
}
